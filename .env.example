# ─── Base de datos MySQL ──────────────────────────────────────────────────────
# En local: XAMPP / MySQL. En produccion: MySQL remoto de Hostinger.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=techo

# ─── Sesion del panel de administracion ───────────────────────────────────────
# Cadena aleatoria de 32 caracteres o mas. Firma la cookie de sesion (HMAC).
# Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sin esta variable el inicio de sesion del panel devuelve error.
SESSION_SECRET=

# ─── Solo para scripts/create-admin.mjs (no se usa en tiempo de ejecucion) ────
# Nunca escribas estos valores en un archivo versionado.
ADMIN_EMAIL=
ADMIN_PASSWORD=
